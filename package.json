{
  "name": "myride-journal",
  "private": true,
  "version": "1.0.0",
  "description": "An offline-first motorcycle trip journal for routes, fuel, expenses, maintenance, photos, weather, and riding history.",
  "author": "Aju Krishna",
  "license": "MIT",
  "keywords": [
    "motorcycle",
    "travel-journal",
    "offline-first",
    "pwa",
    "react",
    "typescript",
    "supabase",
    "indexeddb"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:docs": "node scripts/check-doc-links.mjs",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "generate:screenshots": "node scripts/capture-portfolio-screenshots.mjs",
    "build": "tsc -b && vite build",
    "check:edge": "npx --yes deno check --node-modules-dir=none supabase/functions/explain-myride/index.ts",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "test:edge": "npx --yes deno test --node-modules-dir=none supabase/functions/explain-myride/explanation_test.ts",
    "test:schema": "node scripts/check-supabase-schema.mjs",
    "test:sync": "playwright test --config=playwright.sync.config.ts",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:docs && npm run build && npm run check:edge && npm run test:edge && npm run test:schema && npm run test:e2e && npm run test:sync && npm run test:pwa",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1"
  }
}
